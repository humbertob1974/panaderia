# Copia este archivo como .env.local y llena los valores con los datos
# de tu proyecto de Firebase (Consola > Configuración del proyecto > Tus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (correo automático de confirmación de pedidos) — opcional.
# Crea una cuenta gratis en https://www.emailjs.com y llena estos valores.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
